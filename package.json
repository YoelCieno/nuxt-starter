{
  "name": "nuxt-starter",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate:static": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "generate": "pinion generator/generators/vue-nuxt.tpl.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/ui": "4.10.0",
    "nuxt": "^4.5.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@featherscloud/pinion": "0.5.7",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "4.1.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "vitest-axe": "0.1.0",
    "vue-tsc": "^3.3.9"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
